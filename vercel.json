{
  "functions": {
    "api/ai.py": { "maxDuration": 60, "regions": ["hkg1"] },
    "api/sync.py": { "maxDuration": 60, "regions": ["hkg1"] }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/site/$1" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
